# Mechanical CAD, meshes, and spreadsheets must remain byte-for-byte intact.
*.STEP binary
*.step binary
*.STL binary
*.stl binary
*.DWG binary
*.dwg binary
*.XLSX binary
*.xlsx binary

# Recorded datasets: preserve metadata bytes and store large payloads with Git LFS.
outputs/data/** -text
outputs/data/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
outputs/data/**/*.parquet filter=lfs diff=lfs merge=lfs -text
